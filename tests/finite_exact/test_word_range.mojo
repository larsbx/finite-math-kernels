"""Signed machine-word ranges: edge cases, then the independent corpus.

Run with `pixi run test-word-range`.

The corpus `conformance/word_range_v1.txt` is generated by the Python
reference (`tools/make_word_range_vectors.py`), never by this kernel; every
row is replayed here exactly.
"""

from std.testing import assert_equal, assert_false, assert_true

from finite_exact.word_range import WordRange, word_max, word_min, wrap_word

comptime FIXTURE = "conformance/word_range_v1.txt"


def test_word_bounds() raises:
    assert_equal(word_min(32), -2147483648)
    assert_equal(word_max(32), 2147483647)
    assert_equal(word_min(1), -1)
    assert_equal(word_max(1), 0)


def test_wrap_is_tfhe_overflow() raises:
    # tclmesh tests/tfhe.test T-006: 2147483647 + 1 under FheInt32.
    assert_equal(wrap_word(2147483647 + 1, 32), -2147483648)
    assert_equal(wrap_word(Int.MIN, 32), 0)
    assert_equal(wrap_word(Int.MAX, 32), -1)


def test_refusal_is_sticky() raises:
    var top = WordRange.point(32, word_max(32))
    var one = WordRange.point(32, 1)
    assert_false(top.add(one).accepted())
    assert_false(top.add(one).sub(one).accepted())
    assert_false(WordRange.point(32, word_min(32)).neg().accepted())
    assert_false(WordRange(8, 0, 0).add(WordRange(16, 0, 0)).accepted())
    assert_true(top.sub(one).add(one).contains(word_max(32)))


def test_products_at_the_word_edge() raises:
    var w = WordRange.word(32)
    assert_false(w.mul(w).accepted())
    var half = WordRange(32, -46340, 46340)
    var sq = half.mul(half)
    assert_true(sq.accepted())
    assert_equal(sq.lo, -2147395600)
    assert_equal(sq.hi, 2147395600)


def cell(width: Int, s: String) raises -> WordRange:
    if s == "refused":
        return WordRange.refused(width)
    var parts = s.split(",")
    return WordRange(width, Int(parts[0]), Int(parts[1]))


def apply(op: String, a: WordRange, b: WordRange) raises -> WordRange:
    if op == "add":
        return a.add(b)
    if op == "sub":
        return a.sub(b)
    if op == "mul":
        return a.mul(b)
    if op == "hull":
        return a.hull(b)
    if op == "neg":
        return a.neg()
    raise Error("unknown word-range operation " + op)


def replay() raises -> Int:
    var count = 0
    for raw in open(FIXTURE, "r").read().split("\n"):
        var line = String(raw)
        if line.byte_length() == 0 or line.startswith("#"):
            continue
        var cols = List[String]()
        for col in line.split("\t"):
            cols.append(String(col))
        if cols[0] == "make":
            var width = Int(cols[1])
            var got = WordRange(width, Int(cols[2]), Int(cols[3]))
            assert_equal(String(got), String(cell(width, cols[4])), line)
        elif cols[0] == "wrap":
            assert_equal(wrap_word(Int(cols[2]), Int(cols[1])), Int(cols[3]), line)
        elif cols[0] == "range":
            var width = Int(cols[2])
            var b = WordRange.point(width, 0) if cols[4] == "-" else cell(width, cols[4])
            var got = apply(cols[1], cell(width, cols[3]), b)
            assert_equal(String(got), String(cell(width, cols[5])), line)
        else:
            raise Error("unknown corpus row: " + line)
        count += 1
    return count


def main() raises:
    test_word_bounds()
    test_wrap_is_tfhe_overflow()
    test_refusal_is_sticky()
    test_products_at_the_word_edge()
    var n = replay()
    assert_true(n > 1000)
    print(n, "word-range vectors replayed; 4 edge tests passed.")
