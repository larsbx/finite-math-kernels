"""Replay the independent exact hyperbolic RT vectors through shared Mojo.

Dataset is generated by tools/make_hyperbolic_rt_vectors.py using the
Python matrix-form reference, not the Mojo field-generic contractions.
"""
from std.testing import assert_true, assert_false, assert_equal
from finite_exact.fp import Fp, FpField
from projective_limits.hyperbolic_rt import (
    norm8, polar8, spread8, triple_spread_defect
)

comptime FIXTURE = "conformance/hyperbolic_rt_v1.txt"


def parse_vec[p: Int64](text: String) raises -> List[Fp[p]]:
    var out = List[Fp[p]]()
    for s in text.split(","):
        out.append(Fp[p](Int64(Int(s))))
    assert_equal(len(out), 8)
    return out^


def replay[p: Int64](parts: List[String]) raises:
    var kind = parts[0]
    var expected = parts[len(parts) - 1]
    if kind == "norm":
        assert_true(norm8[FpField[p]](parse_vec[p](parts[2])) == Fp[p](Int64(Int(expected))))
    elif kind == "polar":
        assert_true(polar8[FpField[p]](parse_vec[p](parts[2]),parse_vec[p](parts[3])) == Fp[p](Int64(Int(expected))))
    elif kind == "spread":
        var value = spread8[FpField[p]](parse_vec[p](parts[2]),parse_vec[p](parts[3]))
        if expected == "rejected":
            assert_false(value.accepted())
        else:
            assert_true(value == Fp[p](Int64(Int(expected))))
    elif kind == "triple":
        assert_true(triple_spread_defect[FpField[p]](
            Fp[p](Int64(Int(parts[3]))), Fp[p](Int64(Int(parts[4]))),
            Fp[p](Int64(Int(parts[5])))
        ) == Fp[p](Int64(Int(expected))))
    else:
        raise Error("invalid RT vector kind: "+kind)


def main() raises:
    var count = 0
    for raw in open(FIXTURE, "r").read().split("\n"):
        var line = String(raw)
        if line.byte_length() == 0 or line.startswith("#"):
            continue
        var cols = List[String]()
        for col in line.split("\t"):
            cols.append(String(col))
        var p = Int(cols[1])
        if p == 3:
            replay[3](cols)
        elif p == 5:
            replay[5](cols)
        elif p == 7:
            replay[7](cols)
        else:
            raise Error("unexpected prime in RT fixture")
        count += 1
    assert_equal(count, 48)
    print("[PASS] 48 independent RT golden vectors (Mojo exact)")
